# Which live source to use: mock | sportradar | manual  (default: mock)
DATA_SOURCE=mock

# Sportradar IndyCar — get a key at https://developer.sportradar.com
SPORTRADAR_API_KEY=
SPORTRADAR_EVENT_ID=
# Optional; defaults to the trial v2 base. Set to your access level/version.
# SPORTRADAR_API_BASE=https://api.sportradar.com/indycar/trial/v2/en

# Password for /admin race control (default: pitlane — change this!)
ADMIN_SECRET=

# Vercel KV / Upstash REST — required for manual overrides + source flips to
# persist on Vercel (without these the manual fallback is in-memory only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
