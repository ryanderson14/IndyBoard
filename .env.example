# Which live source to use: mock | espn | sportradar | manual  (default: mock)
DATA_SOURCE=mock

# ESPN — unofficial public API, no key needed. Auto-detects today's
# IndyCar race; override here if you want to pin a specific event id.
# ESPN_EVENT_ID=202605240106

# Sportradar IndyCar — get a key at https://developer.sportradar.com
SPORTRADAR_API_KEY=
SPORTRADAR_EVENT_ID=
# Optional; defaults to the trial v2 base. Set to your access level/version.
# SPORTRADAR_API_BASE=https://api.sportradar.com/indycar/trial/v2/en

# Password for /admin race control (default: pitlane — change this!)
ADMIN_SECRET=

# Vercel Blob — preferred persistence on Vercel Hobby (Marketplace databases
# like Upstash Redis require Pro). Connect Storage → Blob in the Vercel
# dashboard and this is injected automatically.
BLOB_READ_WRITE_TOKEN=

# Vercel KV / Upstash REST — legacy fallback. Used only if BLOB_READ_WRITE_TOKEN
# is empty. Without either, manual overrides are in-memory and reset on cold
# start.
KV_REST_API_URL=
KV_REST_API_TOKEN=
