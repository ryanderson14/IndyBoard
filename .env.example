# Which live source to use: mock | espn | sportradar | manual  (default: mock)
DATA_SOURCE=mock

# ESPN unofficial IndyCar API — free, no key needed. Auto-discovers the
# current race event from the scoreboard. Optionally pin a specific event:
# ESPN_EVENT_ID=

# Sportradar IndyCar — NOTE: their IndyCar product appears to be post-race
# results only, not live timing. Use ESPN instead for live data.
# SPORTRADAR_API_KEY=
# SPORTRADAR_EVENT_ID=

# Password for /admin race control (default: pitlane — change this!)
ADMIN_SECRET=

# Vercel KV / Upstash REST — required for manual overrides + source flips to
# persist on Vercel (without these the manual fallback is in-memory only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
